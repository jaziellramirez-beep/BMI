#include <iostream>
#include <fstream>
#include <string>
#include <sstream>
#include <iomanip>

using namespace std;
// --- Function Prototypes ---
double cmToMeters(double cm);
double calculateBMI(double weightKg, double heightM);
string classifyBMI(double bmi);

int main() {
    string filename = "patients.txt";
    ifstream inputFile(filename);

    if (!inputFile.is_open()) {
        cout << "ERROR: The file '" << filename << "' could not be opened." << endl;
        return 1;
    }

    int expectedPatients = 0;
    if (!(inputFile >> expectedPatients)) {
        cout << "ERROR: Invalid or empty file layout (missing patient count)." << endl;
        cout << "Program ended." << endl;
        return 1;
    }

    // main loop for getting all patients
    for (int i = 1; i <= expectedPatients; ++i) {
        string firstName;
        string lastName;
        double weight = 0.0;
        double height = 0.0;

        // filters for incorrect set up
        if (!(inputFile >> firstName >> lastName >> weight >> height)) {
            if (inputFile.eof()) {
                cout << "ERROR: Expected " << expectedPatients << " patients, but file ended early." << endl;
            } else {
                cout << "(#" << i << ") ERROR: Invalid data format or mismatched text types." << endl;
            }
            cout << "Program ended." << endl;
            return 1;
        }

        // checks to see if the weight and hieght is good(no negative or 0)
        if (weight <= 0) {
            cout << "(#" << i << ") ERROR: The value " << weight << " is invalid for weight in kilograms." << endl;
            cout << "Program ended." << endl;
            return 1;
        }
        double cmToMeters(double cm);
        
        if (height <= 0) {
            cout << "(#" << i << ") ERROR: The value " << height << " is invalid for height in centimeters." << endl;
            cout << "Program ended." << endl;
            return 1;
        }

        // Calculations 
     double heighttometer = cmToMeters(height);
     double bmi = calculateBMI(weight, heighttometer);
        

        cout << "(#" << i << ") " << firstName << " " << lastName << "’s BMI is: " 
             << fixed << setprecision(2) << bmi << endl;
        cout << "The BMI classification is " << classifyBMI( bmi) << endl;
    }

    cout << "Thank you for using our system." << endl;
    inputFile.close();
    return 0;
}



// Converts centimeters to meters
double cmToMeters(double cm) {
    return cm / 100.0;
}

// Calculates BMI 
double calculateBMI(double weightKg, double heightM) {
    return weightKg / (heightM * heightM);
}

// if else BMI
string classifyBMI(double bmi) {
    if (bmi < 18.5) {
        return "Underweight";
    } else if (bmi >= 18.5 && bmi <= 24.9) {
        return "Normal weight";
    } else if (bmi >= 25.0 && bmi <= 29.9) {
        return "Overweight";
    } else {
        return "Obese";
    }
}
